# NUMERA ERP production configuration template
# Placeholder values only. Do not copy real secrets into this file.
# Use a host secret manager or protected runtime environment.

# Immutable private image; replace only during an approved deployment.
OJAZ_IMAGE=ghcr.io/example/ojaz-erp@sha256:REPLACE_WITH_APPROVED_64_HEX_DIGEST

# Required by compose and preflight; supply at runtime, never commit values.
MARIADB_ROOT_PASSWORD=REPLACE_AT_RUNTIME
SITE_ADMIN_PASSWORD=REPLACE_AT_RUNTIME

# Runtime URL and domain plan; empty until a domain is approved.
OJAZ_RUNTIME_URL=
OJAZ_DOMAIN=

# Email is disabled until a provider and sender identity are approved.
EMAIL_ENABLED=false
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=REPLACE_AT_RUNTIME

# Stripe is intentionally disabled during development.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=REPLACE_AT_RUNTIME
STRIPE_WEBHOOK_SECRET=REPLACE_AT_RUNTIME

# Independent backups are not configured until a destination is approved.
BACKUP_ENABLED=false
BACKUP_DESTINATION=
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=REPLACE_AT_RUNTIME
BACKUP_SECRET_KEY=REPLACE_AT_RUNTIME

# Monitoring is local-only until a production provider is approved.
MONITORING_ENABLED=false
MONITORING_ENDPOINT=
MONITORING_API_KEY=REPLACE_AT_RUNTIME
